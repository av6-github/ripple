# ==============================================================================
# RIPPLE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT .env TO GIT.
# This template contains variable names and non-secret placeholders only.
# Copy this file to .env and provide your actual service credentials locally.

# ------------------------------------------------------------------------------
# 1. SUPABASE (Primary Relational Database, Auth, Storage)
# Required for: Phase 0B Infrastructure & Onward
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. NEO4J AURADB (Graph Representation & Network Queries)
# Required for: Phase 0B / Phase 5 Graph Modelling
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j+s://your-db-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ------------------------------------------------------------------------------
# 3. FASTAPI GATEWAY BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_SECRET_KEY=generate-a-secure-random-32-byte-hex-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. ML SCORING SERVICE (FastAPI / Hugging Face Spaces Docker)
# Required for: Phase 4 & Phase 6
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_KEY=your-shared-ml-service-secret-token

# ------------------------------------------------------------------------------
# 5. PINECONE (Vector Store for Peer Similarity & Embeddings)
# Required for: Phase 1.5 / Phase 5
# ------------------------------------------------------------------------------
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ripple-sme-embeddings

# ------------------------------------------------------------------------------
# 6. UPSTASH REDIS (Caching & Ingestion Job Queue)
# Required for: Phase 2 / Phase 7
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ------------------------------------------------------------------------------
# 7. CLOUDINARY (Assessment Report Archival & Visuals)
# Required for: Phase 10
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 8. SENTRY (Error Tracking & Observability)
# Required for: Phase 11
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ------------------------------------------------------------------------------
# 9. FRONTEND (Next.js 16 - Public Client Variables ONLY)
# Rule: Never place service-role keys or backend secrets here.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
JWT_SECRET=your-secure-jwt-signing-secret-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000
